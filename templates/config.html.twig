<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">{{ __('OpenID Configuration', 'openid') }}</h3>
                </div>
                <form method="post" action="{{ action }}">
                    <div class="card-body">
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label" for="client_id">{{ __('Client ID', 'openid') }}</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" name="client_id" id="client_id" value="{{ client_id }}">
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label" for="client_secret">{{ __('Client Secret', 'openid') }}</label>
                            <div class="col-sm-8">
                                <input type="password" class="form-control" name="client_secret" id="client_secret" value="{{ client_secret }}">
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label" for="provider_url">{{ __('Provider URL', 'openid') }}</label>
                            <div class="col-sm-8">
                                <input type="url" class="form-control" name="provider_url" id="provider_url" value="{{ provider_url }}" placeholder="https://auth.example.com">
                            </div>
                        </div>
                        <div class="mb-3 row">
                            <label class="col-sm-4 col-form-label" for="user_field">{{ __('User Field to Match', 'openid') }}</label>
                            <div class="col-sm-8">
                                <input type="text" class="form-control" name="user_field" id="user_field" value="{{ user_field }}" placeholder="e.g. email or username">
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-center">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
                        <button type="submit" name="update" class="btn btn-primary">
                            <i class="fas fa-save"></i> {{ __('Save', 'openid') }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
